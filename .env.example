# ========================================================
# TELEGRAM VA AI SOZLAMALARI
# ========================================================

# 1. Telegram Bot Token (@BotFather dan olingan token)
BOT_TOKEN=your_bot_token_here

# 2. Telegram API ma'lumotlari (https://my.telegram.org dan olinadi)
# Shaxsiy akkauntingizdagi chatlar va guruhlarni kuzatish uchun kerak:
API_ID=your_api_id_here
API_HASH=your_api_hash_here
SESSION_NAME=ai_manager_session

# 3. Sizning Telegram ID raqamingiz (@userinfobot orqali bilib olish mumkin)
# Bot faqat sizning buyruqlaringizga javob berishi uchun xavfsizlik filtri:
ADMIN_ID=your_telegram_id_here

# 4. Google Gemini AI API kaliti (https://aistudio.google.com dan olinadi)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Gemini modeli (gemini-3.6-flash tavsiya etiladi: tez va qulay)
GEMINI_MODEL=gemini-3.6-flash

# 6. Ma'lumotlar bazasi
DATABASE_URL=sqlite+aiosqlite:///tg_manager.db
